      "type": "shell",
      "command": "bun run build",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "VoiceStudio · Build: Desktop-App bauen und starten",
      "detail": "bun run desktop-prod – baut neu und startet die gebaute App",
      "icon": { "id": "play", "color": "terminal.ansiYellow" },
      "type": "shell",
      "command": "bun run desktop-prod",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "runOptions": { "instanceLimit": 1 },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "VoiceStudio · Test: Tests",
      "detail": "bun run test – Tests der Electron-App",
      "icon": { "id": "beaker", "color": "terminal.ansiMagenta" },
      "type": "shell",
      "command": "bun run test",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "VoiceStudio · Test: Typen pruefen",
      "detail": "bun run typecheck",
      "icon": { "id": "symbol-type", "color": "terminal.ansiMagenta" },
      "type": "shell",
      "command": "bun run typecheck",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$tsc"],
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "VoiceStudio · Test: Lint",
      "detail": "bun run lint",
      "icon": { "id": "checklist", "color": "terminal.ansiMagenta" },
      "type": "shell",
      "command": "bun run lint",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "VoiceStudio · Test: Frontend-Tests",
      "detail": "bun run test:frontend",
      "icon": { "id": "beaker", "color": "terminal.ansiMagenta" },
      "type": "shell",
      "command": "bun run test:frontend",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "VoiceStudio · Setup: Pakete installieren",
      "detail": "bun install",
      "icon": { "id": "cloud-download", "color": "terminal.ansiYellow" },
      "type": "shell",
      "command": "bun install",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "VoiceStudio · Setup: API einrichten",
      "detail": "bun run setup:api – uv sync mit passendem PyTorch (GPU oder CPU), dann scripts/setup.py. Laedt mehrere GB",
      "icon": { "id": "server-environment", "color": "terminal.ansiYellow" },
      "type": "shell",
      "command": "bun run setup:api",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "VoiceStudio · Setup: Bun installieren",
      "detail": "einmalig: powershell -c \"irm bun.sh/install.ps1 | iex\"",
      "icon": { "id": "tools", "color": "terminal.ansiYellow" },
      "type": "shell",
      "command": "powershell -NoProfile -Command \"irm bun.sh/install.ps1 | iex\"",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    }
  ]
}
