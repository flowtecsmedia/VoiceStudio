{
  // ============================================================
  // VoiceStudio – Tasks
  // Schema: "VoiceStudio · <Kategorie>: <Aktion>"
  // Kategorien: Dev | Test | Setup
  // Anzeige: Status-Bar-Menue via VsCodeTaskButtons (settings.json)
  //
  // Braucht Bun (packageManager bun@1.4.2) und uv. Fehlt Bun:
  // erst "Setup: Bun installieren", dann VS Code neu starten.
  // ============================================================
  "version": "2.0.0",
  "tasks": [
    {
      "label": "VoiceStudio · Dev: Desktop-App starten",
      "detail": "bun run dev – Electron-App im Dev-Modus",
      "icon": { "id": "rocket", "color": "terminal.ansiGreen" },
      "type": "shell",
      "command": "bun run dev",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "runOptions": { "instanceLimit": 1 },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "VoiceStudio · Dev: Web + API starten",
      "detail": "bun run dev:web – Backend und Browser-Oberflaeche ohne Electron",
      "icon": { "id": "globe", "color": "terminal.ansiCyan" },
      "type": "shell",
      "command": "bun run dev:web",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "runOptions": { "instanceLimit": 1 },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "VoiceStudio · Dev: Nur API starten",
      "detail": "bun run dev:api – nur das Backend",
      "icon": { "id": "server", "color": "terminal.ansiBlue" },
      "type": "shell",
      "command": "bun run dev:api",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "runOptions": { "instanceLimit": 1 },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "VoiceStudio · Test: Frontend-Tests",
      "detail": "bun run test:frontend",
      "icon": { "id": "beaker", "color": "terminal.ansiMagenta" },
      "type": "shell",
      "command": "bun run test:frontend",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "VoiceStudio · Setup: Pakete installieren",
      "detail": "bun install",
      "icon": { "id": "cloud-download", "color": "terminal.ansiYellow" },
      "type": "shell",
      "command": "bun install",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "VoiceStudio · Setup: Bun installieren",
      "detail": "einmalig: powershell -c \"irm bun.sh/install.ps1 | iex\"",
      "icon": { "id": "tools", "color": "terminal.ansiYellow" },
      "type": "shell",
      "command": "powershell -NoProfile -Command \"irm bun.sh/install.ps1 | iex\"",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    }
  ]
}
